# Gmail OAuth credentials (get from Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URL=http://localhost:3000/auth/gmail/callback

# YouTube OAuth credentials (same OAuth app, different account: YoutubeAxle@gmail.com)
YOUTUBE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REDIRECT_URL=http://localhost:3000/auth/youtube/callback

# Server configuration
PORT=3000

# Bind address. Defaults to 127.0.0.1 (this machine only). Set to 0.0.0.0 to
# reach it from your phone or another device.
# HOST=0.0.0.0

# Shared secret, REQUIRED whenever HOST is not loopback. The server refuses to
# start without one, because reaching it from another device would otherwise
# leave your mail readable by anyone who can route to the port.
# Generate with: openssl rand -hex 24
# HELIX_TOKEN=
